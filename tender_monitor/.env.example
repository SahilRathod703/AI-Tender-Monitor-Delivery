# ═══════════════════════════════════════════════════════════════
#  AI Tender Monitor — Environment Configuration
#  Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Anthropic / Claude API ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Database ────────────────────────────────────────────────────
# SQLite (default — no setup needed):
DATABASE_URL=sqlite:///data/tenders.db
# PostgreSQL (for production VPS):
# DATABASE_URL=postgresql://user:password@localhost:5432/tenders_db

# ── Email Reporter ──────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_SENDER=youremail@gmail.com
EMAIL_PASSWORD=your-gmail-app-password     # Use App Password, not your login password
EMAIL_RECIPIENTS=recipient1@gmail.com,recipient2@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Google Sheets Reporter ──────────────────────────────────────
SHEETS_ENABLED=false
GOOGLE_CREDENTIALS_PATH=credentials.json   # Service account JSON file
GOOGLE_SHEET_ID=your-google-sheet-id-here  # From the sheet URL

# ── Scraper Behavior ────────────────────────────────────────────
REQUEST_TIMEOUT=30          # seconds
MAX_RETRIES=3
RETRY_DELAY=5.0             # seconds between retries
TENDER_LOOKBACK_DAYS=1      # Only fetch tenders published in last N days

# ── Schedule (IST) ──────────────────────────────────────────────
# Configured in config/settings.py: 10:00 AM and 7:00 PM IST
# Edit SCHEDULE_TIMES_IST list in settings.py to change times
